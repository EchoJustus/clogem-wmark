(ns watermark.dartvm.host-test
  "The Dart host's adapters on the Dart VM (docs/adr/0014): the profile
  store passes the contract every store passes, files and media behave as
  on the JVM, and the FFmpeg engine finds, probes, decodes and renders with
  the ffmpeg on this machine (those tests say so and pass when there is
  none).

  Run from dart/: clojure -M:cljd test (bb dart)"
  (:require ["dart:io" :as io]
            [cljd.edn :as edn]
            [clojure.string :as str]
            [clojure.test :refer [deftest is testing]]
            [watermark.config :as config]
            [watermark.core.api :as api]
            [watermark.core.features :as features]
            [watermark.core.queue :as queue]
            [watermark.core.rest :as rest]
            [watermark.dartvm.ffmpeg :as ffmpeg]
            [watermark.dartvm.fs :as fs]
            [watermark.dartvm.home :as home]
            [watermark.dartvm.main :as main]
            [watermark.dartvm.media :as media]
            [watermark.dartvm.raster :as raster]
            [watermark.dartvm.store :as store]
            [watermark.engine :as engine]
            [watermark.media :as pmedia]
            [watermark.queue-contract :as queue-contract]
            [watermark.raster.image :as image]
            [watermark.store-contract :as contract]
            [watermark.util.task :as task]))

(defn- adapters-golden []
  (edn/read-string (fs/read-text "../kernel/test/golden/adapters.edn")))

(defn- pattern-bytes
  "`n` bytes whose byte i is (7 + 31i) mod 256: adapters.edn's files."
  [n]
  (let [a (image/u8-array n)]
    (dotimes [i n] (image/u8! a i (mod (+ 7 (* 31 i)) 256)))
    a))

(deftest the-file-store-passes-the-store-contract
  (contract/run-all (store/file-store (fs/join (fs/temp-dir "wmark-store") "profiles"))))

(deftest the-job-queue-passes-the-queue-contract
  (task/then (queue-contract/run-all queue/queue) queue-contract/assert-all))

(deftest profiles-are-files-the-jvm-reads
  (let [dir (fs/join (fs/temp-dir "wmark-store") "profiles")
        st  (store/file-store dir)]
    (contract/crud st)
    (config/create-profile! st "Wide 16:9" {:logo {:anchor :top-left}})
    (is (= ["wide-16-9.edn"] (mapv :name (fs/list-files dir))) "one file per profile, named by its slug")
    (is (str/includes? (fs/read-text (fs/join dir "wide-16-9.edn")) ":anchor :top-left"))
    (is (empty? (filter #(str/starts-with? (:name %) ".") (fs/list-files dir))) "no temp file is left behind")))

(deftest files-behave-as-on-the-jvm
  (let [dir (fs/temp-dir "wmark-fs")
        p   (fs/join (fs/join dir "a") "b.txt")]
    (fs/write-text-atomically! p "one")
    (fs/write-text-atomically! p "two")
    (is (= "two" (fs/read-text p)))
    (is (= [{:name "b.txt"}] (mapv #(select-keys % [:name]) (fs/list-files (fs/join dir "a")))))
    (is (true? (fs/delete! p)))
    (is (false? (fs/delete! p)))
    (is (= [] (fs/list-files (fs/join dir "missing"))))
    (is (= "b.txt" (fs/file-name p)))
    (is (= (fs/join dir "a") (fs/parent p)))))

(deftest a-file's-fingerprint-is-the-jvm's
  (let [dir    (fs/temp-dir "wmark-media")
        golden (into {} (map (juxt :size :fingerprint)) (:fingerprints (adapters-golden)))]
    (doseq [size [0 1 1000 1048577]]
      (let [p (fs/join dir (str size ".bin"))]
        (fs/write-bytes! p (pattern-bytes size))
        (is (= (golden size) (media/fingerprint p)) (str "the fingerprint of " size " bytes"))))))

(deftest media-publishes-a-finished-output-only
  (let [dir   (fs/temp-dir "wmark-media")
        input (fs/join dir "clip.mov")
        io    (media/local-media)]
    (fs/write-bytes! input (pattern-bytes 10))
    (is (= {:id input :location input} (select-keys (pmedia/open-input io {} input) [:id :location])))
    (is (= :invalid (try (pmedia/open-input io {} (fs/join dir "none.mov")) nil
                         (catch cljd.core/ExceptionInfo e (:wmark/error (ex-data e))))))
    (let [out (pmedia/open-output io {} input {:output {}})]
      (is (= (fs/join dir "clip_wm.mp4") (:final out)))
      (is (= (fs/join dir "clip_wm.part.mp4") (:temp out)))
      (is (= :failed (try (pmedia/commit! io {} out) nil
                          (catch cljd.core/ExceptionInfo e (:wmark/error (ex-data e)))))
          "success without a file is a failure")
      (fs/write-bytes! (:temp out) (pattern-bytes 3))
      (is (= (:final out) (pmedia/commit! io {} out)))
      (is (fs/file? (:final out)))
      (is (not (fs/file? (:temp out))))
      (is (= :conflict (try (pmedia/open-output io {} input {:output {}}) nil
                            (catch cljd.core/ExceptionInfo e (:wmark/error (ex-data e)))))
          "a taken name fails before any encoding")
      (is (= (:final out) (:final (pmedia/open-output io {} input {:output {:overwrite? true}})))))
    (let [out (pmedia/open-output io {} input {:output {:dir (fs/join dir "out") :suffix "-x" :container "mkv"}})]
      (is (= (fs/join (fs/join dir "out") "clip-x.mkv") (:final out)))
      (fs/write-bytes! (:temp out) (pattern-bytes 3))
      (pmedia/discard! io {} out)
      (is (not (fs/file? (:temp out)))))))

(deftest the-home-keeps-a-secret
  (let [h (fs/temp-dir "wmark-home")
        a (home/studio-secret! h)
        b (home/studio-secret! h)]
    (is (= 32 (count a)))
    (is (= (vec a) (vec b)) "created once, then read")
    (is (= h (home/resolve-home {:home h})))))

;; ---------------------------------------------------------------------------
;; The FFmpeg engine, with the ffmpeg on this machine

(defn- ffmpeg-path [] (:path (:ffmpeg (ffmpeg/locate-binaries {}))))

(defn- sh! [argv]
  (let [r (ffmpeg/exec argv)]
    (when-not (zero? (:exit r)) (throw (ex-info (str "ffmpeg failed: " (:err r)) {})))
    r))

(defn- make-media!
  "A 1-second white clip with silent audio and a two-colour logo."
  [dir]
  (let [ff   (ffmpeg-path)
        clip (fs/join dir "clip.mp4")
        logo (fs/join dir "logo.png")]
    (sh! [ff "-hide_banner" "-loglevel" "error" "-y" "-f" "lavfi" "-i" "color=c=white:s=320x180:r=25"
           "-f" "lavfi" "-i" "anullsrc=r=48000:cl=stereo" "-t" "1" "-c:v" "mpeg4" "-q:v" "3"
           "-pix_fmt" "yuv420p" "-c:a" "aac" "-shortest" clip])
    (sh! [ff "-hide_banner" "-loglevel" "error" "-y" "-f" "lavfi" "-i"
           "color=c=0x2255dd:s=40x16,format=rgba" "-frames:v" "1" logo])
    {:clip clip :logo logo}))

(defn- when-ffmpeg [f]
  (if (ffmpeg-path)
    (f)
    (do (println "  (skipped: no ffmpeg on this machine)") nil)))

(deftest the-engine-finds-and-describes-ffmpeg
  (when-ffmpeg
   #(task/then (ffmpeg/ffmpeg-engine {:work-root (fs/temp-dir "wmark-work")})
               (fn [eng]
                 (let [info (engine/info eng)]
                   (is (:available? info) (pr-str (:problems info)))
                   (is (= :ffmpeg (:engine/id info)))
                   (is (contains? (get-in info [:capabilities :spec-versions]) 2))
                   (is (= :found (:status (last (get-in info [:binaries :ffmpeg :trail])))))
                   (is (seq (:encoders info)) "trial encodes found an encoder that works"))))))

(deftest the-engine-probes-decodes-and-samples
  (when-ffmpeg
   #(task/then (ffmpeg/ffmpeg-engine {:work-root (fs/temp-dir "wmark-work")})
               (fn [eng]
                 (let [dir (fs/temp-dir "wmark-media")
                       {:keys [clip logo]} (make-media! dir)
                       facts (engine/probe eng clip)
                       still (engine/decode-still eng logo)
                       px    (:px still)]
                   (is (= {:kind :video :width 320 :height 180 :fps-num 25 :fps-den 1 :has-audio? true}
                          (select-keys facts [:kind :width :height :fps-num :fps-den :has-audio?])))
                   (is (= 25 (:frames facts)))
                   (is (= [40 16] [(:width still) (:height still)]))
                   (is (= [0x22 0x55 0xdd 0xff] (mapv (fn [i] (image/u8 px i)) (range 4))) "straight RGBA8")
                   (is (= :invalid (try (engine/probe eng (fs/join dir "none.mp4")) nil
                                        (catch cljd.core/ExceptionInfo e (:wmark/error (ex-data e))))))
                   (let [sample (fs/join dir "sample.mp4")]
                     (engine/sample-video eng {:width 64 :height 36 :fps 25 :seconds 1} sample)
                     (is (= 64 (:width (engine/probe eng sample))))))))))

(defn- render-with [spec-version]
  (let [h   (fs/temp-dir "wmark-home")
        dir (fs/temp-dir "wmark-media")
        {:keys [clip logo]} (make-media! dir)
        events (atom [])]
    (-> (main/system {:home h :render-spec spec-version})
        (task/then (fn [sys]
                     (task/then (api/run-batch! sys {:tenant "local" :user "local"}
                                                {:profile  :none
                                                 :settings {:logo  {:path logo :anchor :top-left}
                                                            :texts [{:mode :continuous :content "(c) Dart"}]}
                                                 :inputs   [clip]}
                                                {:on-event #(swap! events conj %)})
                                (fn [r] [sys r]))))
        (task/then (fn [[sys r]]
                     (let [[res] (:results r)]
                       (is (= :done (:state res)) (pr-str res))
                       (is (fs/file? (fs/join dir "clip_wm.mp4")))
                       (is (not (fs/file? (fs/join dir "clip_wm.part.mp4"))))
                       (is (some #(= :progress (:type %)) @events) "progress came from -progress lines")
                       (is (= [] (fs/list-files (fs/join h "work"))) "no scratch file is left")
                       (is (= 25 (:frames (engine/probe (:engine sys) (fs/join dir "clip_wm.mp4")))))
                       (is (some? (api/get-profile sys {:tenant "local" :user "local"} "latest"))
                           "a real run records latest")))))))

(deftest a-batch-renders-with-render-spec-1
  (when-ffmpeg #(render-with 1)))

(deftest a-batch-renders-with-render-spec-2
  ;; the host draws: the logo decoded by the engine, text in the bundled font
  (when-ffmpeg #(render-with 2)))

(deftest a-cancelled-render-ends-its-ffmpeg
  (when-ffmpeg
   #(task/then (ffmpeg/ffmpeg-engine {:work-root (fs/temp-dir "wmark-work")})
               (fn [eng]
                 (let [dir  (fs/temp-dir "wmark-media")
                       ff   (ffmpeg-path)
                       out  (fs/join dir "long.mp4")
                       plan {:workdir (fs/join dir "scratch") :files {} :total-us 60000000
                             :argv [ff "-hide_banner" "-nostdin" "-y" "-re" "-f" "lavfi" "-i" "color=c=gray:s=64x36:r=25"
                                    "-t" "60" "-progress" "pipe:1" out]}
                       h    (engine/execute! eng plan nil)]
                   (task/then (task/then (Future/delayed (Duration .milliseconds 500)) (fn [_] (engine/cancel! h)))
                              (fn [_] (task/then (engine/outcome h)
                                                 (fn [o] (is (= :cancelled (:status o)) (pr-str o)))))))))))

(deftest the-host-sees-each-render's-ffmpeg
  ;; an app rendering in its own process ends FFmpeg with itself; it is
  ;; handed each render's process through :on-process
  (when-ffmpeg
   (fn []
     (let [dir  (fs/temp-dir "wmark-media")
           {:keys [clip]} (make-media! dir)
           seen (atom [])]
       (-> (main/system {:home (fs/temp-dir "wmark-home") :render-spec 2
                         :on-process (fn [^io/Process p] (swap! seen conj (.-pid p)))})
           (task/then (fn [sys]
                        (api/run-batch! sys {:tenant "local" :user "local"}
                                        {:profile  :none
                                         :settings {:texts [{:mode :continuous :content "(c) Dart"}]}
                                         :inputs   [clip]}
                                        {})))
           (task/then (fn [r]
                        (is (= [:done] (mapv :state (:results r))) (pr-str r))
                        (is (= 1 (count @seen)) "one render, one FFmpeg")
                        (is (every? pos? @seen)))))))))

(deftest a-render-allowance-is-kept-on-the-dart-vm
  ;; docs/adr/0017: a turn is taken as a render starts and kept only when
  ;; it finishes; with none left, the render fails before FFmpeg runs
  (when-ffmpeg
   (fn []
     (let [dir    (fs/temp-dir "wmark-media")
           {:keys [clip]} (make-media! dir)
           copy   (fs/join dir "copy.mp4")
           _      (.copySync (io/File clip) copy)
           used   (atom 0)
           log    (atom [])
           al     (reify features/RenderAllowance
                    (renders-left [_ _] (- 1 @used))
                    (reserve-render! [_ _] (swap! log conj :reserve) (when (< @used 1) (swap! used inc) true))
                    (settle-render! [_ _ done?] (swap! log conj [:settle done?]) (when-not done? (swap! used dec))))]
       (-> (main/system {:home (fs/temp-dir "wmark-home") :render-spec 2})
           (task/then (fn [sys]
                        (let [sys (assoc sys :allowance al)]
                          (task/then (api/run-batch! sys {:tenant "local" :user "local"}
                                                     {:profile  :none
                                                      :settings {:texts [{:mode :continuous :content "(c) Dart"}]}
                                                      :inputs   [clip copy]}
                                                     {})
                                     (fn [r] [sys r])))))
           (task/then (fn [[sys r]]
                        (is (= [:done :failed] (mapv :state (:results r))) (pr-str r))
                        (is (= :render-limit (:kind (second (:results r)))))
                        (is (= [:reserve [:settle true] :reserve] @log))
                        (is (= 0 (:renders-left (api/features sys {:tenant "local" :user "local"}))))
                        (is (= :render-limit
                               (try (api/run-batch! sys {:tenant "local" :user "local"}
                                                    {:profile :none :settings {} :inputs [clip]} {})
                                    nil
                                    (catch cljd.core/ExceptionInfo e (:wmark/error (ex-data e)))))
                            "a batch is refused before it starts"))))))))

;; ---------------------------------------------------------------------------
;; Jobs through the queue, as an app submits them

(def ^:private ctx {:tenant "local" :user "local"})

(defn- follow-job
  "Submit a job for `clip` on `sys`, calling (on-event event job) for each of
  its events; a task of [job-as-submitted job-at-its-end events]."
  [sys clip logo on-event]
  (let [ended  (task/deferred)
        events (atom [])
        k      (str "follow-" (random-uuid))]
    (api/subscribe-jobs! sys ctx k
                         (fn [e]
                           (swap! events conj e)
                           (on-event e)
                           (when (#{:done :failed :cancelled} (:state (:job e)))
                             (api/unsubscribe-jobs! sys ctx k)
                             (task/complete! ended (:job e)))))
    (let [job (api/submit-job! sys ctx {:profile  :none
                                        :settings {:logo  {:path logo :anchor :top-left}
                                                   :texts [{:mode :continuous :content "(c) Dart"}]}
                                        :inputs   [clip]})]
      (task/then (task/task-of ended) (fn [end] [job end @events])))))

(deftest a-queued-job-renders
  (when-ffmpeg
   (fn []
     (let [dir (fs/temp-dir "wmark-media")
           {:keys [clip logo]} (make-media! dir)]
       (-> (main/system {:home (fs/temp-dir "wmark-home") :render-spec 2})
           (task/then (fn [sys]
                        (task/then (follow-job sys clip logo (fn [_]))
                                   (fn [[job end events]]
                                     (is (= :queued (:state job)))
                                     (is (= (:id job) (:id end)))
                                     (is (= :done (:state end)) (pr-str end))
                                     (is (= [:done] (mapv :state (:result end))))
                                     (is (= [:queued :running] (take 2 (distinct (map (comp :state :job) events))))
                                         "queued, then running")
                                     (is (some (comp :progress :job) events) "progress reached the job")
                                     (is (fs/file? (fs/join dir "clip_wm.mp4")))
                                     (is (= [(:id job)] (mapv :id (api/list-jobs sys ctx)))))))))))))

(deftest a-queued-job-cancels
  (when-ffmpeg
   (fn []
     (let [dir (fs/temp-dir "wmark-media")
           {:keys [clip logo]} (make-media! dir)]
       (-> (main/system {:home (fs/temp-dir "wmark-home") :render-spec 2})
           (task/then (fn [sys]
                        (let [asked (atom false)]
                          (task/then (follow-job sys clip logo
                                                 (fn [e]
                                                   (when (and (= :running (:state (:job e)))
                                                              (compare-and-set! asked false true))
                                                     (api/cancel-job! sys ctx (:id (:job e))))))
                                     (fn [[_ end _]]
                                       (is (= :cancelled (:state end)) (pr-str end))
                                       (is (not (fs/file? (fs/join dir "clip_wm.mp4"))) "nothing was published")
                                       (is (not (fs/file? (fs/join dir "clip_wm.part.mp4"))))))))))))))

(deftest the-rest-contract-answers-in-process
  ;; what an app embedding the library does instead of HTTP
  (-> (main/system {:home (fs/temp-dir "wmark-home")})
      (task/then
       (fn [sys]
         (let [ask (fn [method path body] (rest/respond sys ctx method path (constantly body)))]
           (-> (ask :post "/api/v1/profiles" {:name "Wide 16:9" :settings {:logo {:anchor "top-left" :opacity 0.5}}})
               (task/then (fn [created]
                            (is (= 201 (:status created)) (pr-str created))
                            (is (= "wide-16-9" (get-in created [:body "profile/slug"])))
                            (ask :get "/api/v1/profiles/Wide%2016%3A9" nil)))
               (task/then (fn [got]
                            (is (= "top-left" (get-in got [:body "settings" "logo" "anchor"])) "found by its name")
                            (is (= 0.5 (get-in got [:body "settings" "logo" "opacity"])))
                            (ask :get "/api/v1/profiles/wide-16-9/form" nil)))
               (task/then (fn [form]
                            (is (= 200 (:status form)))
                            (is (seq (get-in form [:body "form"])) "the settings form")
                            (ask :get "/api/v1/jobs" nil)))
               (task/then (fn [jobs]
                            (is (= {:status 200 :body {"jobs" []}} jobs))
                            (ask :get "/api/v1/profiles/nope" nil)))
               (task/then (fn [missing]
                            (is (= 404 (:status missing)))
                            (is (= "not-found" (get-in missing [:body "error"])))))))))))
