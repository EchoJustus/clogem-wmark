<!-- Embedded into Windows native images by wmark.build/native. With UTF-8 as
     the process code page (Windows 10 1903 and later), the C runtime hands the
     program its arguments as UTF-8, which is how the image decodes them; under
     a legacy code page, `vidéo\clip é.mp4` and "(c) Studio —" arrived mangled. -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
