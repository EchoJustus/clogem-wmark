# clogem-wmark: strict ignore rules. This repository is PUBLIC.
#
# Rules of thumb:
# - Never weaken a rule to commit something. If a file here is ignored and
#   truly belongs in git, add a narrow negation (!path) with a comment.
# - Git on Windows and macOS ignores case (core.ignorecase), so no pattern
#   here may also match LICENSE, NOTICE or a source file under another case.
# - Check before a commit:  git status --ignored --short

# -- Secrets and key material (anywhere in the tree) ---------------------------
secrets/
*.pem
*.key
*.der
*.p8
*.p12
*.pfx
*.jks
*.keystore
*.kdbx
*.gpg
*.ppk
*.crt
*.cer
*.csr
*.mobileprovision
*.provisionprofile
id_rsa*
id_ed25519*
id_ecdsa*
.env
.env.*
!.env.example
.envrc
.secrets
.netrc
.npmrc
.pgpass
.git-credentials
service-account*.json
*-service-account.json

# -- wmark runtime data --------------------------------------------------------
# Portable data folder (profiles, the studio secret, license, runtime token).
wmark-data/
# Rendered and scratch media (tests generate their clips; nothing is committed).
*.mp4
*.mov
*.m4v
*.mkv
*.webm
*.avi
*.mxf
*.m2ts
# FFmpeg dropped next to the sources for the ./ and ./bin/ lookup (GPL binaries).
/bin/
/ffmpeg
/ffprobe
ffmpeg.exe
ffprobe.exe

# -- Build output --------------------------------------------------------------
# build/ is SOURCE (the wmark.build library): never ignore it.
/target/
/dist/
/classes/
/out/
*.class
*.jar
*.so
*.dylib
*.dll
*.exe
*.o
*.obj
*.a
*.lib
*.pdb
*.ilk
*.exp
# GraalVM native-image error reports (they include the build environment).
svm_err_*.md
*.build_artifacts.txt
# Release archives and installers.
*.zip
*.tar.gz
*.tgz
*.7z
*.dmg
*.pkg
*.msi
*.msix
*.deb
*.rpm
*.AppImage
*.app/

# -- JVM crash and profiling dumps (can contain memory contents) --------------
hs_err_pid*.log
replay_pid*.log
*.hprof
*.jfr
*.log

# -- Clojure tooling -----------------------------------------------------------
.cpcache/
.clj-kondo/.cache/
/.lsp/
.nrepl-port
.rebel_readline_history
.calva/
.portal/
.shadow-cljs/

# -- Claude Code: personal settings stay local -----------------------------------
.claude/settings.local.json
CLAUDE.local.md

# -- Test tooling (Python Playwright for test/e2e) --------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
test-results/
playwright-report/

# -- No Node.js, ever (defensive) -----------------------------------------------
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# -- Editors and IDEs --------------------------------------------------------------
.idea/
*.iml
.vscode/
*.code-workspace
.fleet/
.project
.classpath
.settings/
*.sublime-workspace
.history/
*~
*.swp
*.swo
.#*
\#*\#

# -- Operating systems ------------------------------------------------------------
.DS_Store
._*
.AppleDouble
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# -- Leftovers --------------------------------------------------------------------
*.bak
*.orig
*.rej
*.tmp
