;;
;; Day-to-day tasks. All of them go through deps.edn: the component aliases
;; and the :wmark/build-matrix are the only build configuration.
{:tasks
 {test       {:doc "Every test (native-engine tests need a C compiler; conformance needs ffmpeg)"
              :task (clojure "-M:dev:test")}
  lint       {:doc "Validate the build matrix and the component deps.edn files" :task (clojure "-T:build lint")}
  matrix     {:doc "What ships at each roadmap stage"                 :task (clojure "-T:build matrix")}
  dev        {:doc "Run the engine from source (opens the browser)"   :task (apply clojure "-M:dev -m watermark.main" *command-line-args*)}
  native     {:doc "Native binary for this OS (bb native, or bb native :target :engine)"
              :task (apply clojure "-T:build native" (or (seq *command-line-args*) [":target" ":engine"]))}
  ffmpeg     {:doc "Fetch the pinned FFmpeg for this OS into target/ffmpeg/<platform> (SHA-256 verified)"
              :task (apply clojure "-T:build ffmpeg" *command-line-args*)}
  bundle     {:doc "Assemble a download, e.g. bb bundle :bundle :desktop-server :ffmpeg-dir target/ffmpeg/linux-x64"
              :task (apply clojure "-T:build bundle" *command-line-args*)}
  smoke      {:doc "Smoke-test built binaries, e.g. bb smoke --bin target/bin --ffmpeg target/ffmpeg/linux-x64/bin"
              :task (apply shell "bb" "test/smoke/native.clj" *command-line-args*)}
  sdk        {:doc "Engine SDK archive for a tag, e.g. bb sdk :name abi-v2"
              :task (apply clojure "-T:build sdk" *command-line-args*)}
  kernel-dart {:doc "The kernel on the Dart VM: ClojureDart compiles it, its golden vectors run there (Dart SDK on PATH)"
               :task (apply shell {:dir "kernel/dart"} "clojure" "-M:cljd" "test" *command-line-args*)}
  dart       {:doc "The Dart host on the Dart VM: its adapters' tests, with the ffmpeg on PATH (Dart SDK on PATH)"
              :task (apply shell {:dir "dart"} "clojure" "-M:cljd" "test" *command-line-args*)}
  dart-cli   {:doc "wmark-dart, the CLI on the Dart VM: target/dart-cli/wmark-dart with the bundled font (Dart SDK on PATH)"
              :requires ([babashka.fs :as fs] [clojure.string :as str])
              :task (let [out "target/dart-cli"
                          exe (str out "/wmark-dart" (when (fs/windows?) ".exe"))]
                      (shell {:dir "dart"} "dart" "pub" "get")
                      (shell {:dir "dart"} "clojure" "-M:cljd" "compile")
                      (fs/create-dirs (str out "/fonts"))
                      ;; the version the release workflow stamps, as a compile-time constant
                      (shell {:dir "dart"} "dart" "compile" "exe" "bin/wmark_dart.dart" "-o" (str "../" exe)
                             (str "-DWMARK_VERSION=" (str/trim (slurp "desktop/resources/wmark/version.txt"))))
                      ;; next to the program, where wmark-dart looks first (Fira Sans Bold, OFL)
                      (fs/copy "resources/fonts/wmark.ttf" (str out "/fonts/wmark.ttf") {:replace-existing true})
                      (fs/copy "licenses/FiraSans-OFL.txt" (str out "/fonts/OFL.txt") {:replace-existing true})
                      (println "wmark-dart:" exe (fs/size exe) "bytes"))}
  e2e        {:doc "Browser smoke test of the built-in UI: needs ffmpeg and Python Playwright (test tooling only)"
              :requires ([babashka.fs :as fs])
              :task (shell "python3" "test/e2e/ui_smoke.py"
                           "bb" "clojure" "-M:desktop:web" "-m" "watermark.main"
                           "--home" (str (fs/create-temp-dir {:prefix "wmark-e2e-home"}))
                           "serve" "--announce" "json")}
  mock-engine {:doc "Build the mock native engine (Linux; see native/README.md for macOS and Windows)"
               :requires ([babashka.fs :as fs])
               :task (do (fs/create-dirs "target")
                         (shell "cc -shared -fPIC -O2 -pthread -o target/libwmark_engine.so native/mock/mock_engine.c"))}}}
