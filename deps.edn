;;
;; clogem-wmark -- the open core of wmark, batch video watermarking that makes
;; AI watermark removal harder. One repository, several artifacts.
;;
;; Layout. Each component is a source root; each alias below adds one. The
;; components other repositories build on also have their own deps.edn, so
;; they can be consumed as  {:git/url ... :git/sha ... :deps/root "<dir>"}:
;;   kernel/   portable domain kernel (.cljc): settings, render spec, schedules,
;;             engine protocol -- also compiled by ClojureDart (own deps.edn)
;;   src/      JVM host core: config, stores, media, jobs, Core API, engines,
;;             REST routes (this file's :paths; consumed as the repository root)
;;   web/      built-in web UI: server-rendered HTML + Datastar (vendored
;;             datastar.js, no npm)                                (own deps.edn)
;;   desktop/  CLI, http-kit server, loopback security (needs web/) (own deps.edn)
;;   testkit/  conformance harness, store contract, golden vectors (own deps.edn)
;;   build/    wmark.build, the interpreter of the matrix below     (own deps.edn)
;;   native/   C ABI for native engines (+ a mock used by tests)
;; `bb lint` fails if a component's deps.edn and its alias here disagree.
;;
;; Everyday commands (bb.edn wraps them):
;;   clojure -T:build matrix        what ships at each stage
;;   clojure -T:build lint          check this file's matrix
;;   clojure -T:build native :target :engine
;;   clojure -T:build bundle :bundle :desktop-server :ffmpeg-dir <dir>
;;   clojure -M:dev:test            every test
;;
;; Every JVM dependency must work under GraalVM native-image: no runtime
;; eval, no reflection (every namespace sets *warn-on-reflection*), nothing
;; environment-dependent in top-level defs. JDK 25 (the GraalVM 25 baseline:
;; the native engine binding uses the Foreign Function & Memory API).
{:paths ["src" "resources"]

 :deps
 {org.clojure/clojure                  {:mvn/version "1.12.6"}
  wmark/kernel                         {:local/root "kernel"}
  org.clojure/data.json                {:mvn/version "2.5.2"}
  ;; initialises Clojure namespaces at image build time; v1 needs the
  ;; explicit --features flag (see the matrix), not --initialize-at-build-time
  com.github.clj-easy/graal-build-time {:mvn/version "1.0.6"}}

 :aliases
 {;; -- Components (keep in step with <component>/deps.edn) ------------------
  :web      {:extra-paths ["web/src" "web/resources"]
             :extra-deps  {http-kit/http-kit {:mvn/version "2.8.1"}}}         ; Apache-2.0
  ;; the desktop shell mounts the web UI: targets list both aliases
  :desktop  {:extra-paths ["desktop/src" "desktop/resources"]
             :extra-deps  {http-kit/http-kit {:mvn/version "2.8.1"}}}        ; Apache-2.0

  ;; -- Development -----------------------------------------------------------
  ;; A C compiler enables the native-engine tests; ffmpeg enables conformance.
  :dev      {:extra-paths ["testkit/src" "build/src" "kernel/test" "test" "web/test" "desktop/test"
                           "web/src" "web/resources" "desktop/src" "desktop/resources"]
             :extra-deps  {http-kit/http-kit {:mvn/version "2.8.1"}}
             :jvm-opts    ["--enable-native-access=ALL-UNNAMED"]}
  :test     {:extra-deps {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
             :main-opts  ["-m" "cognitect.test-runner"
                          "-d" "kernel/test" "-d" "test" "-d" "web/test" "-d" "desktop/test"]}
  :build    {:deps       {wmark/build {:local/root "build"}}   ; build/deps.edn brings tools.build
             :ns-default wmark.build}}

 ;; -- Build matrix ------------------------------------------------------------
 ;; What ships from this repository. tools.deps can't compose aliases inside
 ;; deps.edn, so targets are data naming component aliases and wmark.build
 ;; (build/) -- a generic interpreter with no target knowledge -- resolves them.
 ;; The commercial editions and the apps are built elsewhere, on top of this
 ;; repository, with the same interpreter.
 :wmark/build-matrix
 {:editions
  {:community {:aliases []}}

  :targets
  {:engine {:doc          "Headless engine: local web UI (Datastar), REST API, CLI"
            :toolchain    :jvm
            :aliases      [:desktop :web]
            :editions     [:community]
            :main         {:community watermark.main}
            :artifact     {:community "wmark"}
            :native-image ["--no-fallback"
                           "-march=compatibility"      ; default x86-64-v3 crashes on older CPUs
                           ;; shutdown hooks on Ctrl+C need no flag: GraalVM 25 installs
                           ;; exit handlers in executables by default
                           "--features=clj_easy.graal_build_time.InitClojureClasses"
                           "--enable-native-access=ALL-UNNAMED" ; native engines (FFM)
                           "-H:+ReportExceptionStackTraces"]}}

  :bundles
  {:desktop-server {:doc       "Engine + FFmpeg sidecar, unzip and run"
                    :platforms [:windows :macos :linux]
                    :targets   [:engine]
                    :sidecars  [:ffmpeg :ffprobe]}}

  :stages
  {1 {:name "WebServer for Windows, then macOS" :bundles [:desktop-server]}}

  ;; GraalVM releases native builds must use where the latest 25.x won't do.
  ;; GraalVM 25.0.2 dropped macOS x64, and Intel Macs stay supported, so
  ;; their builds are pinned to 25.0.1 (ADR 0007). `native` enforces this,
  ;; and the workflows' macos-x64 matrix entries must name the same release.
  :graalvm {:macos-x64 "25.0.1"}

  ;; -- FFmpeg for the bundles ------------------------------------------------
  ;; Exact builds per platform, by URL and SHA-256; never "latest". Bundles
  ;; ship LGPL builds (docs/adr/0001-ffmpeg-in-release-bundles.md): with
  ;; render spec v2 wmark draws the flip and the text itself, so FFmpeg needs
  ;; no GPL-only filter. Linux and Windows take BtbN's LGPL build of one
  ;; FFmpeg commit. No maintained macOS LGPL build exists, so macOS builds
  ;; FFmpeg's release source (signed by the FFmpeg release key) with the
  ;; recipe under :build: LGPL-3.0-or-later, linking nothing but FFmpeg and
  ;; the OS. `clojure -T:build ffmpeg` fetches or builds them and checks each
  ;; binary against its pin; `bundle` adds the license and source notes.
  ;; The GPL builds stay pinned as a variant (`:variant :gpl`): they add
  ;; x264/x265 and `perspective`, for comparisons and render spec v1.
  :ffmpeg
  {:license   {:spdx  "LGPL-3.0-or-later"
               :texts [{:file   "COPYING.LGPLv3"
                        :url    "https://raw.githubusercontent.com/FFmpeg/FFmpeg/n9.0.1/COPYING.LGPLv3"
                        :sha256 "da7eabb7bafdf7d3ae5e9f223aa5bdc1eece45ac569dc21b3b037520b4464768"}
                       ;; the LGPLv3 is a set of additional permissions on the GPLv3
                       {:file   "COPYING.GPLv3"
                        :url    "https://raw.githubusercontent.com/FFmpeg/FFmpeg/n9.0.1/COPYING.GPLv3"
                        :sha256 "8ceb4b9ee5adedde47b31e975c1d90c73ad27b6b165a1dcd80c7c545eb65b903"}]}
   :platforms
   {:linux-x64   {:version  "n9.0.1-11-ge47273f4d9"
                  :archives [{:url    "https://github.com/BtbN/FFmpeg-Builds/releases/download/autobuild-2026-08-31-13-27/ffmpeg-n9.0.1-11-ge47273f4d9-linux64-lgpl-9.0.tar.xz"
                              :sha256 "204fc02692b11249c3e688ad18538ce2939129a1fc6abc32a6b2638a024496cf"}]
                  :source   ["FFmpeg: https://github.com/FFmpeg/FFmpeg/commit/e47273f4d9 (release/9.0 branch)"
                             "Build scripts and library versions: https://github.com/BtbN/FFmpeg-Builds/tree/autobuild-2026-08-31-13-27"]}
    :windows-x64 {:version  "n9.0.1-11-ge47273f4d9"
                  :archives [{:url    "https://github.com/BtbN/FFmpeg-Builds/releases/download/autobuild-2026-08-31-13-27/ffmpeg-n9.0.1-11-ge47273f4d9-win64-lgpl-9.0.zip"
                              :sha256 "2484854ad6988d34560f4e6ea7a6ecb9dde0af7c229d2591815d056b04ec4f56"}]
                  :source   ["FFmpeg: https://github.com/FFmpeg/FFmpeg/commit/e47273f4d9 (release/9.0 branch)"
                             "Build scripts and library versions: https://github.com/BtbN/FFmpeg-Builds/tree/autobuild-2026-08-31-13-27"]}
    ;; the source tarball's signature was checked against the FFmpeg release
    ;; key FCF9 86EA 15E6 E293 A564 4F10 B432 2F04 D676 58D8 (2026-09-27);
    ;; the pin is its SHA-256. Intel Macs need nasm to build (a tool only).
    :macos-arm64 {:version  "9.0.2"
                  :build    {:source    {:url    "https://ffmpeg.org/releases/ffmpeg-9.0.2.tar.xz"
                                         :sha256 "8c3850283eb25fa026482078a04051e0be17347b09ef81a0849bec15a96e002e"}
                             :configure ["--enable-version3" "--disable-autodetect"
                                          "--enable-videotoolbox" "--enable-audiotoolbox"
                                          "--enable-zlib" "--enable-bzlib"
                                          "--disable-ffplay" "--disable-doc" "--disable-debug"
                                          "--extra-cflags=-mmacosx-version-min=11.0"
                                          "--extra-ldflags=-mmacosx-version-min=11.0"
                                          "--extra-version=wmark"]}
                  :source   ["FFmpeg 9.0.2: https://ffmpeg.org/releases/ffmpeg-9.0.2.tar.xz (the archive above, unmodified)"]}
    :macos-x64   {:version  "9.0.2"
                  :build    {:source    {:url    "https://ffmpeg.org/releases/ffmpeg-9.0.2.tar.xz"
                                         :sha256 "8c3850283eb25fa026482078a04051e0be17347b09ef81a0849bec15a96e002e"}
                             :configure ["--enable-version3" "--disable-autodetect"
                                          "--enable-videotoolbox" "--enable-audiotoolbox"
                                          "--enable-zlib" "--enable-bzlib"
                                          "--disable-ffplay" "--disable-doc" "--disable-debug"
                                          "--extra-cflags=-mmacosx-version-min=11.0"
                                          "--extra-ldflags=-mmacosx-version-min=11.0"
                                          "--extra-version=wmark"]}
                  :source   ["FFmpeg 9.0.2: https://ffmpeg.org/releases/ffmpeg-9.0.2.tar.xz (the archive above, unmodified)"]}}
   ;; BtbN keeps month-end autobuilds; martin-riedl.de keeps its releases.
   :variants
   {:gpl {:license   {:spdx "GPL-3.0-or-later"
                      :text {:url    "https://raw.githubusercontent.com/FFmpeg/FFmpeg/n9.0.1/COPYING.GPLv3"
                             :sha256 "8ceb4b9ee5adedde47b31e975c1d90c73ad27b6b165a1dcd80c7c545eb65b903"}}
          :platforms
          {:linux-x64   {:version  "n9.0.1-11-ge47273f4d9"
                         :archives [{:url    "https://github.com/BtbN/FFmpeg-Builds/releases/download/autobuild-2026-08-31-13-27/ffmpeg-n9.0.1-11-ge47273f4d9-linux64-gpl-9.0.tar.xz"
                                     :sha256 "182c1b509720e939bb47bfb47dc29cc0c298640401128e3dce8627d10707eb5a"}]
                         :source   ["FFmpeg: https://github.com/FFmpeg/FFmpeg/commit/e47273f4d9 (release/9.0 branch)"
                                    "Build scripts and library versions: https://github.com/BtbN/FFmpeg-Builds/tree/autobuild-2026-08-31-13-27"]}
           :windows-x64 {:version  "n9.0.1-11-ge47273f4d9"
                         :archives [{:url    "https://github.com/BtbN/FFmpeg-Builds/releases/download/autobuild-2026-08-31-13-27/ffmpeg-n9.0.1-11-ge47273f4d9-win64-gpl-9.0.zip"
                                     :sha256 "ec9db2cda1f5894ab95446076ad8bf49379db4b53c02e778ad3b49adf91fec83"}]
                         :source   ["FFmpeg: https://github.com/FFmpeg/FFmpeg/commit/e47273f4d9 (release/9.0 branch)"
                                    "Build scripts and library versions: https://github.com/BtbN/FFmpeg-Builds/tree/autobuild-2026-08-31-13-27"]}
           :macos-arm64 {:version  "9.0.2"
                         :archives [{:url    "https://ffmpeg.martin-riedl.de/download/macos/arm64/1789931890_9.0.2/ffmpeg.zip"
                                     :sha256 "c8ed4c4e6978a03c485edbfe4e0a5dc2380f8a30bba5150531b31b094492d924"}
                                    {:url    "https://ffmpeg.martin-riedl.de/download/macos/arm64/1789931890_9.0.2/ffprobe.zip"
                                     :sha256 "fcbe839537485eaee7a7a8bc5cbc0f90d53617e80943e8a5b2e31cb851197ea6"}]
                         :source   ["FFmpeg: https://github.com/FFmpeg/FFmpeg/tree/n9.0.2"
                                    "Build script and library versions: https://git.martin-riedl.de/ffmpeg/build-script and https://ffmpeg.martin-riedl.de/download/macos/arm64/1789931890_9.0.2/versions.txt"]}
           :macos-x64   {:version  "9.0.2"
                         :archives [{:url    "https://ffmpeg.martin-riedl.de/download/macos/amd64/1789931006_9.0.2/ffmpeg.zip"
                                     :sha256 "7c6b4125b191cbf773832dc51f424cf2b6bb7da43007d1e066f95909e47cacd4"}
                                    {:url    "https://ffmpeg.martin-riedl.de/download/macos/amd64/1789931006_9.0.2/ffprobe.zip"
                                     :sha256 "2322438ed2f6319a691291b247d09c69dcaa3a982460d1f269a7e1af335cfdfd"}]
                         :source   ["FFmpeg: https://github.com/FFmpeg/FFmpeg/tree/n9.0.2"
                                    "Build script and library versions: https://git.martin-riedl.de/ffmpeg/build-script and https://ffmpeg.martin-riedl.de/download/macos/amd64/1789931006_9.0.2/versions.txt"]}}}}}}}
