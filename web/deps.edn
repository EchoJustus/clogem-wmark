;;
;; The built-in web UI (Datastar) as a library, for repositories that build on
;; clogem-wmark:  wmark/web {:git/url ... :git/sha ... :deps/root "web"}
;; It needs the host core (the repository root, wmark/core) next to it; the
;; consumer declares both. Must match the :web alias in ../deps.edn (bb lint).
{:paths ["src" "resources"]
 :deps  {http-kit/http-kit {:mvn/version "2.8.1"}}}
