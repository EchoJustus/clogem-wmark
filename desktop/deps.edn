;;
;; The desktop shell (CLI, http-kit server, loopback security, sidecar mode,
;; native-image metadata) as a library:
;;   wmark/desktop {:git/url ... :git/sha ... :deps/root "desktop"}
;; It mounts the web UI, so consumers declare wmark/core and wmark/web as well.
;; Must match the :desktop alias in ../deps.edn (bb lint).
{:paths ["src" "resources"]
 :deps  {http-kit/http-kit     {:mvn/version "2.8.1"}
         org.clojure/tools.cli {:mvn/version "1.4.256"}}}
