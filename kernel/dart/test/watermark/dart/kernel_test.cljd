(ns watermark.dart.kernel-test
  "Every kernel namespace, compiled for the Dart VM and loaded (the JVM's
  architecture test keeps this list complete), and what differs by host."
  (:require [clojure.test :refer [deftest is]]
            [watermark.config]
            [watermark.core.api]
            [watermark.core.features]
            [watermark.core.form]
            [watermark.core.jobs]
            [watermark.core.modes :as modes]
            [watermark.core.resolve]
            [watermark.core.schema :as schema]
            [watermark.core.seeds]
            [watermark.engine]
            [watermark.ffmpeg.graph]
            [watermark.ffmpeg.parse]
            [watermark.ffmpeg.plan]
            [watermark.files]
            [watermark.media]
            [watermark.raster]
            [watermark.raster.color]
            [watermark.raster.image :as image]
            [watermark.raster.text]
            [watermark.raster.truetype]
            [watermark.render]
            [watermark.render.layout]
            [watermark.render.schema :as spec-schema]
            [watermark.render.v2]
            [watermark.store]
            [watermark.store.memory]
            [watermark.util.chars]
            [watermark.util.edn]
            [watermark.util.host]
            [watermark.util.num :as number]
            [watermark.util.prng]
            [watermark.util.schema]
            [watermark.util.task :as task]
            [watermark.util.text :as text]
            [watermark.util.time]
            [watermark.util.unicode]
            [watermark.util.unicode-data]))

(deftest the-open-core's-modes-are-built-in
  ;; no top-level form runs when a Dart library loads
  (is (= #{:continuous :scheduled} (modes/available))))

(deftest numbers-wrap-at-64-bits
  (is (= -9223372036854775808 (number/add-wrap 9223372036854775807 1)))
  (is (= 9223372036854775807 (number/sub-wrap -9223372036854775808 1)))
  (is (= -2 (number/mul-wrap 9223372036854775807 2)))
  (is (= -3 (number/round-half-up -3.5)) "halves toward +infinity, like the JVM here"))

(deftest bytes-are-unsigned
  (let [a (image/u8-array 2)]
    (image/u8! a 0 255)
    (is (= 255 (image/u8 a 0)))
    (is (= 0 (image/u8 a 1)))))

(deftest json-schema-comes-from-the-jvm
  (doseq [f [schema/json-schema spec-schema/json-schema]]
    (is (= :unavailable (try (f) nil (catch cljd.core/ExceptionInfo e (:wmark/error (ex-data e))))))))

(deftest trimming-is-javas-not-darts
  ;; Dart's String.trim also removes no-break spaces and the byte order mark
  (is (= "\u00A0a\u00A0" (text/trim " \u00A0a\u00A0\u3000")))
  (is (= "\uFEFFa" (text/trim "\uFEFFa")))
  (is (not (text/blank? "\u00A0"))))

(deftest tasks-are-futures
  ;; errors skip then, reach recover as thrown, and always runs either way;
  ;; reduce waits for each step
  (let [seen (atom [])
        d    (task/deferred)]
    (task/complete! d 40)
    (-> (task/task-of d)
        (task/then inc)
        (task/then (fn [v] (throw (ex-info "boom" {:v v}))))
        (task/then (fn [_] (swap! seen conj :skipped)))
        (task/recover (fn [e] (swap! seen conj (ex-data e)) :recovered))
        (task/always #(swap! seen conj :always))
        (task/then (fn [v]
                     (is (= :recovered v))
                     (is (= [{:v 41} :always] @seen))
                     (task/reduce (fn [acc x] (if (= x 3) (reduced acc) (task/resolved (+ acc x)))) 0 (range 10))))
        (task/then (fn [total] (is (= 3 total)))))))
